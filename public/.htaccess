<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # SPA Routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ─── PWA: MIME Types ────────────────────────────────────────────────────────
# Required so browsers accept the service worker script and web manifest.
# Without these, Apache may serve .js as text/plain and Chrome will refuse
# to register the service worker (MIME type mismatch error).
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType image/png .png
  AddType image/x-icon .ico
</IfModule>

# ─── PWA: Service Worker Scope Header ────────────────────────────────────────
# Allows the service worker to claim the full site scope.
<IfModule mod_headers.c>
  <FilesMatch "sw\.js$">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Prevent manifest from being cached so updates propagate
  <FilesMatch "manifest\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

